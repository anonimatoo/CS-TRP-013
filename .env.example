DATABASE_URL=postgresql://USUARIO:SENHA@HOST/BANCO?sslmode=verify-full
ADMIN_PASSWORD=
SESSION_SECRET=
ENCRYPTION_KEY=
WEBHOOK_SECRET=
APP_ORIGIN=http://localhost:5173
NODE_ENV=development
PORT=3001
MIN_PRICE_CENTS=100
MAX_PRICE_CENTS=2147483647
ALLOW_LIVE_PAYMENTS=false

# Preencher com a referência da habilitação confirmada para a conta e o ambiente.
PAGARME_DEBIT_APPROVAL_TEST=
PAGARME_DEBIT_APPROVAL_LIVE=

# Referências por UUID do lojista e ambiente. Exemplo de formato: {"UUID":{"test":"referência","live":"referência"}}
PAGARME_MERCHANT_DEBIT_APPROVALS={}

# Transporte financeiro. Para AWS SES, use o endpoint SMTP da região e um remetente verificado.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
# Sugestão exibida no painel. O envio requer autorização por lojista e destinatário.
EMAIL_REPORT_RECIPIENT=
EMAIL_REPORT_ENABLED=false
EMAIL_REPORT_ON_CAPTURE=false
# Valor aleatório com pelo menos 32 caracteres, usado pelo agendador.
CRON_SECRET=
